{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/auth-server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:auth": "tsx --test src/services/authService.test.ts",
    "build:api": "tsc -p tsconfig.server.json",
    "start:api": "node dist-server/server/auth-server.js",
    "loadtest:pilot": "tsx server/loadtest/pilot-800.ts",
    "dev:demo": "vite --mode demo",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "test": "tsx --test src/services/authService.test.ts server/test-scoring/engine.test.ts server/*.test.ts server/surveys/*.test.ts",
    "test:integration": "node scripts/test-disposable-db.mjs",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed:demo": "tsx server/seed-demo.ts",
    "preview:demo": "vite preview --mode demo --outDir dist-demo --host 127.0.0.1 --port 4173",
    "build:acceptance": "tsc -p tsconfig.acceptance.json",
    "package:acceptance": "python3 scripts/package-acceptance.py"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "10.5.0",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.15.0",
    "rehype-raw": "^7.0.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "protobufjs": "7.6.6",
    "proxy-addr": "2.0.8",
    "body-parser": "1.20.9",
    "qs": "6.16.1",
    "ws": "8.21.0"
  }
}
