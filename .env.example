# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Gemini model used by chatbot API
GEMINI_CHAT_MODEL="gemini-2.5-flash"

# Chat limits / memory / RAG tuning
CHAT_MAX_MESSAGE_LENGTH="1200"
CHAT_MAX_HISTORY_MESSAGES="8"
CHAT_MAX_CONTEXT_CHUNKS="5"
CHAT_SESSION_TTL_MINUTES="45"
CHAT_MAX_SESSIONS="500"
CHAT_KNOWLEDGE_DIR="chatbot-knowledge"
CHAT_SYSTEM_PROMPT_FILE="SYSTEM_PROMPT_TRAM_AN.md"

# -----------------------------
# Auth API server (Phase 3)
# -----------------------------

# PostgreSQL connection string used by backend auth service.
# Local example only; choose a project-scoped native PostgreSQL or verified Neon connection:
# - user: tram_an
# - password: StrongPass123!
# - db: tram_an_db
DATABASE_URL="postgresql://tram_an:StrongPass123%21@localhost:5432/tram_an_db"

# Backend auth server port
AUTH_API_PORT="3001"

# HMAC secret for signing access token (REQUIRED in production)
AUTH_SESSION_SECRET="change-this-secret-in-production"

# Access token lifetime in seconds (default: 8h)
AUTH_ACCESS_TOKEN_TTL_SECONDS="28800"

# Deprecated: startup NEVER seeds users.
# Set "false" in production.
AUTH_SEED_TEST_USERS="false"

# CORS allowed origin for auth API.
# Dev: use "*". Production: set exact frontend domain (e.g. https://app.example.com)
AUTH_API_CORS_ORIGIN="*"

# -----------------------------
# Frontend auth client
# -----------------------------

# Vite dev proxy target for /api/*
AUTH_API_PROXY_TARGET="http://localhost:3001"

# Optional: frontend direct base URL to auth API.
# Leave empty to use relative path (/api) + Vite proxy in local.
VITE_AUTH_API_BASE_URL=""

# Deprecated: API failure never falls back to fixture auth.
# In production, set to "false".
VITE_ENABLE_AUTH_FALLBACK="false"

# -----------------------------
# Email OTP (Gmail SMTP)
# -----------------------------

# OTP time-to-live in seconds (default: 300 = 5 minutes)
AUTH_REGISTER_OTP_TTL_SECONDS="300"

# Max wrong attempts for each OTP session
AUTH_REGISTER_OTP_MAX_ATTEMPTS="5"

# Cooldown between two OTP requests for same username/email (seconds)
AUTH_REGISTER_OTP_RESEND_COOLDOWN_SECONDS="30"

# In dev only: include OTP code in API response for quick testing
AUTH_REGISTER_OTP_EXPOSE_DEV_CODE="false"

# Gmail SMTP credentials (App Password required)
AUTH_GMAIL_SMTP_USER="your-gmail@gmail.com"
AUTH_GMAIL_SMTP_APP_PASSWORD="your-16-char-app-password"

# Optional sender display email, fallback to AUTH_GMAIL_SMTP_USER
AUTH_EMAIL_FROM="your-gmail@gmail.com"

# -----------------------------
# Admin/Superadmin Phone OTP (2FA login)
# -----------------------------

# TTL for admin login OTP in seconds
AUTH_ADMIN_LOGIN_OTP_TTL_SECONDS="300"

# Maximum wrong attempts for each admin login OTP session
AUTH_ADMIN_LOGIN_OTP_MAX_ATTEMPTS="5"

# Cooldown between two admin OTP sends (seconds)
AUTH_ADMIN_LOGIN_OTP_RESEND_COOLDOWN_SECONDS="30"

# In dev only: include admin OTP code in API response for quick testing
AUTH_ADMIN_LOGIN_OTP_EXPOSE_DEV_CODE="false"

# Real collection is locked by default; enabling requires explicit reviewed policies and rollout authorization.
SURVEY_REAL_COLLECTION_ENABLED="false"
SURVEY_ALLOW_SERVER_DEMO="false"
# Explicit local/disposable DB seeding only; never called from start/health.
ALLOW_DEMO_SEED="false"
# CRON_SECRET must be provisioned in this project before a maintenance schedule is activated.
CRON_SECRET=""

# Runtime TLS; production rejects disable and SSL parameters in DATABASE_URL.
DB_TLS_MODE="verify-full"
DB_TLS_CA_FILE=""
# Optional file transports: DATABASE_URL_FILE, AUTH_SESSION_SECRET_FILE, CRON_SECRET_FILE.
# Explicit SMTP transport (otherwise legacy Gmail variables apply). STARTTLS is required if not implicit TLS.
AUTH_SMTP_HOST=""
AUTH_SMTP_PORT="587"
AUTH_SMTP_SECURE="false"
AUTH_SMTP_CA_FILE=""
# AUTH_SMTP_USER / AUTH_SMTP_PASSWORD (or *_FILE) must be provided together when auth is required.

# Public invitation QR origin; production requires HTTPS and an origin without path/query/hash.
# Defaults to APP_URL. Set a reachable private-LAN HTTP origin ONLY for explicit synthetic tests.
SURVEY_PUBLIC_BASE_URL=""

# Scheduler preparation only: no cloud triggers or background job starts by default.
SCHEDULER_ENABLED="false"
# Native maintenance runner: HTTPS origin only, scoped to this project.
MAINTENANCE_BASE_URL=""
# Optional protected Vercel Preview access (project-only secret, never VITE_).
VERCEL_PROTECTION_BYPASS=""
