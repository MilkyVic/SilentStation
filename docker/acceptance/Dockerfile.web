ARG NODE_IMAGE=node:22.23.5-alpine
ARG WEB_IMAGE=nginx:1.28-alpine
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --registry=https://registry.npmjs.org --no-audit --no-fund
COPY . .
ENV VITE_ACCEPTANCE_BANNER=true
RUN npm run build
FROM ${WEB_IMAGE}
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/acceptance/nginx.conf /etc/nginx/nginx.conf
USER 101:101
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
