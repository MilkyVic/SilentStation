{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-server",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "sourceMap": false,
    "declaration": false,
    "allowJs": false,
    "allowImportingTsExtensions": false,
    "rootDir": "."
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "server/**/*.test.ts",
    "server/loadtest/**",
    "server/test-fixtures/**",
    "server/seed-demo.ts",
    "server/test-question-bank.ts"
  ]
}
