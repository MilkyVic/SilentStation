ARG NODE_IMAGE=node:22.23.5-alpine
FROM ${NODE_IMAGE} AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --registry=https://registry.npmjs.org --no-audit --no-fund
FROM deps AS build
COPY . .
RUN npm run build:api
FROM deps AS runtime-deps
COPY scripts/prune-api.mjs ./scripts/prune-api.mjs
RUN node scripts/prune-api.mjs && npm prune --omit=dev --ignore-scripts --no-audit --no-fund --registry=https://registry.npmjs.org
FROM ${NODE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=runtime-deps --chown=node:node /app/package*.json ./
COPY --from=runtime-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist-server ./dist-server
COPY --from=build --chown=node:node /app/server/sql ./server/sql
COPY --from=build --chown=node:node /app/chatbot-knowledge ./chatbot-knowledge
USER node
EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=8s --start-period=20s --retries=6 CMD node -e "fetch('http://127.0.0.1:3001/api/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist-server/server/auth-server.js"]
FROM deps AS acceptance-tools
COPY . .
RUN npm run build:acceptance
USER node
